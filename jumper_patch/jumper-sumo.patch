+"""jumper.sumo.tactics -- a tactician that steers a frozen walking policy in the ring
+(jumper-challenge-2026).
+
+The learner here does not move joints: it chooses a velocity and a posture
+command every step from what it sees of the opponent and the ring, and a frozen
+posture policy walks it. See `env_cfg.py` and `mdp.py`.
+"""
+
+from __future__ import annotations
+
+from ....registry import register
+from ...common.assets import JUMPER_ASSETS
+
+register(
+    id="jumper.sumo.tactics",
+    assets=JUMPER_ASSETS,
+    description="sumo tactician: velocity and posture commands to a frozen walking policy, against a walking opponent",
+    tags=("jumper", "sumo", "multi-robot", "hierarchical"),
+)
diff --git a/tasks/jumper/sumo/tactics/env_cfg.py b/tasks/jumper/sumo/tactics/env_cfg.py
new file mode 100644
index 0000000..57ba4f4
--- /dev/null
+++ b/tasks/jumper/sumo/tactics/env_cfg.py
@@ -0,0 +1,202 @@
+"""jumper.sumo.tactics: the sumo ring with a tactician in charge of the robot.
+
+`jumper.sumo` trains the walking policy itself to push, and the only thing it is
+told is "walk at the opponent": it cannot choose to side-step, circle or give
+way, because following the command is what it is paid for. Here the walking is
+frozen and the choice is what is learned:
+
+- **The robot's action** is `mdp.TacticsAction`: six numbers mapped onto a
+  velocity and a posture command, smoothed, and handed to a frozen walking
+  policy (`LOW_LEVEL_CHECKPOINT`, or `JUMPER_TACTICS_LOW`) that runs inside the
+  environment exactly as the opponent's does. The robot's original 415-wide
+  observation becomes that policy's private observation.
+- **The tactician's observation** (`mdp.py`): its own motion, the opponent's
+  position, heading, velocity and tilt in its frame, the ring, and the bout's
+  phase. The critic also sees whether the two are touching.
+- **Rewards**: the bout (win +30, loss -30, `jumper.sumo`'s), pushing the
+  opponent outwards, a penalty for standing near the straw, a small pull to stay
+  engaged after the tachiai, and a penalty on jerky choices. The posture task's
+  walking rewards are gone: walking is not this learner's job.
+- **Reading the opponent** (`JUMPER_TACTICS_TREND=1`): a moving average of how
+  the opponent has been moving (`mdp.opponent_trend`), for runs against a pool
+  of opponents. It changes the observation width, so a checkpoint trained with
+  it replays only with it.
+- **Styles** (`JUMPER_TACTICS_STYLE=mawari`): a dense term for how a bout is
+  worked, not only how it ends. `mawari` pays for being to the opponent's side
+  or back while touching it (`mdp.behind`), the way to okuridashi.
+- **Technique coaches** (`JUMPER_TACTICS_COACH=oshidashi,okuridashi,...`): a
+  bonus on top of the win when the referee names one of those kimarite, so a
+  run can be steered towards a technique and its share measured.
+- **Claws** (`JUMPER_TACTICS_WAZA=1`, `waza.py`): seven more outputs -- each
+  claw's opening (an open claw reaches for the mawashi; closed there, it holds
+  it), strikes with either arm (tsuki, harite, hataki, kachiage) and their speed,
+  and how low to crouch in the shikiri -- and what it knows of them (16 inputs:
+  claw tips at the opponent's mawashi, grips both ways, strikes, and the kind of
+  wrestler it is being trained as, `waza.STYLES`, drawn per bout from
+  `JUMPER_TACTICS_RIKISHI`). Paid by style: grips held, strikes landed, an
+  opponent turned while held, and a bonus for winning by the style's kimarite.
+- Everything else -- the opponent, the ring, the shikiri and tachiai, the gyoji
+  and referee when asked for -- is `jumper.sumo`'s.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import os
+from pathlib import Path
+
+from mjlab.envs.mdp.observations import last_action
+from mjlab.envs.mdp.rewards import action_rate_l2
+from mjlab.managers.observation_manager import ObservationGroupCfg, ObservationTermCfg
+from mjlab.managers.reward_manager import RewardTermCfg
+from mjlab.managers.termination_manager import TerminationTermCfg
+
+from ..env_cfg import (
+    _NEUTRAL_HEIGHT, OPPONENT_CHECKPOINT, RING_RADIUS, _add_referee_terms,
+)
+from ..env_cfg import env_cfg as sumo_env_cfg
+from ..opponent import HeldCommandCfg, opponent_observation_group
+from ..referee import KIMARITE, referee_watch
+from .mdp import (
+    TacticsActionCfg, behind, bout_phase, closing, in_contact, kimarite_won, near_straw, opponent_relative,
+    opponent_trend,
+    own_motion, ring_state,
+)
+
+TACTICS = "tactics"
+#: A technique coach's bonus, on top of the win's 30 (one step, so / step_dt).
+COACH_BONUS = 15.0
+#: A style term's weight, per second of the style (the bout's +30 is once).
+STYLE_WEIGHT = 2.0
+#: Claws (`waza.py`): a strike that lands, once; a strike begun, once (a cost);
+#: a win by the style's own kimarite, once (the win's 30 on top).
+STRIKE_HIT_PAY = 0.5
+STRIKE_COST = 0.05
+WAZA_KIMARITE_BONUS = 15.0
+#: The walking policy the tactician steers. The official posture example by
+#: default (it tracks the whole command range); `JUMPER_TACTICS_LOW` swaps in
+#: another, e.g. a `jumper.sumo`-trained one that already knows how to push.
+LOW_LEVEL_CHECKPOINT = OPPONENT_CHECKPOINT
+
+
+def env_cfg(asset: Path | None = None, play: bool = False):
+    cfg = sumo_env_cfg(asset=asset, play=play)
+
+    # ── The walking policy keeps the robot's own observation, privately ────
+    low_level = opponent_observation_group(
+        cfg.observations["actor"], entity="robot", twist="twist", posture="posture",
+        action=TACTICS)
+    cfg.commands["twist"] = HeldCommandCfg(initial=(0.0, 0.0, 0.0))
+    cfg.commands["posture"] = HeldCommandCfg(initial=(0.0, 0.0, 0.0, _NEUTRAL_HEIGHT))
+    cfg.curriculum = {}
+    base = cfg.actions.pop("joint_pos")
+    kwargs = {f.name: getattr(base, f.name) for f in dataclasses.fields(base) if f.init}
+    checkpoint = os.environ.get("JUMPER_TACTICS_LOW") or str(LOW_LEVEL_CHECKPOINT)
+    cfg.actions = {
+        TACTICS: TacticsActionCfg(
+            **kwargs, checkpoint=checkpoint, observation_group=low_level,
+            twist_name="twist", posture_name="posture", neutral_height=_NEUTRAL_HEIGHT),
+        **cfg.actions,
+    }
+
+    # ── What the tactician sees ─────────────────────────────────────────────
+    if not any(s.name == "bout_contact" for s in (cfg.scene.sensors or ())):
+        _add_referee_terms(cfg)
+    actor = {
+        "own_motion": ObservationTermCfg(func=own_motion),
+        "opponent": ObservationTermCfg(func=opponent_relative),
+        "ring": ObservationTermCfg(func=ring_state, params={"radius": RING_RADIUS}),
+        "bout": ObservationTermCfg(func=bout_phase),
+        "actions": ObservationTermCfg(func=last_action),
+    }
+    if os.environ.get("JUMPER_TACTICS_TREND", "") == "1":
+        actor["trend"] = ObservationTermCfg(func=opponent_trend)
+    waza_on = os.environ.get("JUMPER_TACTICS_WAZA", "") == "1"
+    if waza_on:
+        from .waza import claws_state
+
+        actor["claws"] = ObservationTermCfg(func=claws_state)
+    if os.environ.get("JUMPER_TACTICS_MEMORY", "") == "1":
+        # About a second of the bout as it was (mdp.bout_memory): last, so a
+        # checkpoint widened for it (tools/train/expand_memory.py) keeps its columns.
+        from .mdp import bout_memory
+
+        actor["memory"] = ObservationTermCfg(func=bout_memory)
+    critic = dict(actor, contact=ObservationTermCfg(func=in_contact))
+    cfg.observations = {
+        "actor": ObservationGroupCfg(terms=actor),
+        "critic": ObservationGroupCfg(terms=critic),
+    }
+
+    # ── What it is paid for ─────────────────────────────────────────────────
+    bout_terms = {k: cfg.rewards[k] for k in ("sumo_win", "sumo_loss", "push_out") if k in cfg.rewards}
+    cfg.rewards = {
+        **bout_terms,
+        "near_straw": RewardTermCfg(func=near_straw, weight=-2.0, params={"radius": RING_RADIUS}),
+        "closing": RewardTermCfg(func=closing, weight=0.5),
+        "action_rate": RewardTermCfg(func=action_rate_l2, weight=-0.02),
+    }
+    style = os.environ.get("JUMPER_TACTICS_STYLE", "")
+    if style == "mawari":
+        cfg.rewards["behind"] = RewardTermCfg(func=behind, weight=STYLE_WEIGHT)
+    elif style:
+        raise ValueError(f"JUMPER_TACTICS_STYLE: unknown style {style!r}")
+    coach = tuple(n for n in os.environ.get("JUMPER_TACTICS_COACH", "").split(",") if n)
+    if coach:
+        unknown = set(coach) - {n for n, _ in KIMARITE}
+        assert not unknown, f"JUMPER_TACTICS_COACH: no such kimarite {sorted(unknown)}"
+        step_dt = cfg.sim.mujoco.timestep * cfg.decimation
+        if "referee" not in cfg.terminations and "bout_over" not in cfg.terminations:
+            cfg.terminations["referee"] = TerminationTermCfg(
+                func=referee_watch, params={"radius": RING_RADIUS})
+        cfg.rewards["technique"] = RewardTermCfg(
+            func=kimarite_won, weight=COACH_BONUS / step_dt,
+            params={"names": coach, "radius": RING_RADIUS})
+    variety = float(os.environ.get("JUMPER_TACTICS_VARIETY", "0"))
+    if variety > 0.0:
+        # A win pays more the rarer its kimarite has been (mdp.rare_kimarite_won, 10/20).
+        from .mdp import rare_kimarite_won
+
+        step_dt = cfg.sim.mujoco.timestep * cfg.decimation
+        if "referee" not in cfg.terminations and "bout_over" not in cfg.terminations:
+            cfg.terminations["referee"] = TerminationTermCfg(
+                func=referee_watch, params={"radius": RING_RADIUS})
+        cfg.rewards["variety"] = RewardTermCfg(
+            func=rare_kimarite_won, weight=variety / step_dt, params={"radius": RING_RADIUS})
+    comeback = float(os.environ.get("JUMPER_TACTICS_COMEBACK", "0"))
+    if comeback > 0.0:
+        # A win pays more the nearer the straw the winner had been driven (mdp.comeback_won, 10/21).
+        from .mdp import comeback_won
+
+        step_dt = cfg.sim.mujoco.timestep * cfg.decimation
+        if "referee" not in cfg.terminations and "bout_over" not in cfg.terminations:
+            cfg.terminations["referee"] = TerminationTermCfg(
+                func=referee_watch, params={"radius": RING_RADIUS})
+        cfg.rewards["comeback"] = RewardTermCfg(
+            func=comeback_won, weight=comeback / step_dt, params={"radius": RING_RADIUS})
+    if waza_on:
+        from .waza import (
+            grip_held, strike_begun, strike_landed, style_kimarite_won, turned_while_held,
+        )
+
+        step_dt = cfg.sim.mujoco.timestep * cfg.decimation
+        if "referee" not in cfg.terminations and "bout_over" not in cfg.terminations:
+            cfg.terminations["referee"] = TerminationTermCfg(
+                func=referee_watch, params={"radius": RING_RADIUS})
+        cfg.rewards["grip"] = RewardTermCfg(func=grip_held, weight=1.0)
+        cfg.rewards["strike_hit"] = RewardTermCfg(func=strike_landed, weight=STRIKE_HIT_PAY / step_dt)
+        cfg.rewards["strike_cost"] = RewardTermCfg(func=strike_begun, weight=-STRIKE_COST / step_dt)
+        cfg.rewards["throw_turn"] = RewardTermCfg(func=turned_while_held, weight=1.0)
+        cfg.rewards["style_kimarite"] = RewardTermCfg(
+            func=style_kimarite_won, weight=WAZA_KIMARITE_BONUS / step_dt,
+            params={"radius": RING_RADIUS})
+        claw_bonus = float(os.environ.get("JUMPER_WAZA_CLAW_BONUS", "0"))
+        if claw_bonus > 0.0:
+            # A win by the claws (a leg or arm held, a strike, a throw) paid on top.
+            from .waza import claw_kimarite_won
+
+            cfg.rewards["claw_kimarite"] = RewardTermCfg(
+                func=claw_kimarite_won, weight=claw_bonus / step_dt, params={"radius": RING_RADIUS})
+    if not play:
+        cfg.episode_length_s = 20.0
+    return cfg
diff --git a/tasks/jumper/sumo/tactics/league.py b/tasks/jumper/sumo/tactics/league.py
new file mode 100644
index 0000000..8443382
--- /dev/null
+++ b/tasks/jumper/sumo/tactics/league.py
@@ -0,0 +1,258 @@
+"""A league opponent: every bout, one of a whole roster of wrestlers (jumper-challenge-2026).
+
+`opponent.py`'s pool draws among walking policies; `rival.py` puts one frozen
+tactician on the west side. This draws, every bout and per environment, among a
+roster that mixes both -- walkers that walk at the robot, and tacticians that
+steer their own walking policy -- so one learner can be trained against everything
+trained so far: the "comprehensive" wrestler of 10/10 evening, against the
+pusher, the reader, the puller and the circler in turn.
+
+    JUMPER_SUMO_LEAGUE   a roster file, the round robin's format
+                         (name|kind|checkpoint|walking policy|trend|waza|memory)
+
+A wrestler with a memory (the 7th field 1, a claw wrestler trained with
+JUMPER_TACTICS_MEMORY=1, 10/15 night) reads the bout's last second as well, so the
+learner can meet the strongest so far -- itself frozen -- in the league.
+
+Per step: every tactician in the roster is run on the tactician observation
+(seen from the opponent; with the trend input, and its first 28 numbers for a
+tactician trained without), each environment keeps its own entry's choice; the
+commands are a tactician's mapped choice or a walker's walk-at-the-robot; then
+every walking policy in the roster runs on the opponent's posture observation and
+each environment keeps its own entry's. All on the GPU, a handful of small MLPs.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+import torch
+
+from mjlab.envs.mdp.actions.actions import JointPositionAction
+
+from ..mdp import SHIKIRI_POSTURE, bout, hold_mark, shikiri_or
+from ..opponent import OPPONENT, FrozenActor, OpponentPolicyActionCfg, approach_command
+from .mdp import ACTION_DIM, TacticsAction
+from .rival import OpponentTacticsActionCfg, tactician_group
+
+if TYPE_CHECKING:
+    from mjlab.envs import ManagerBasedRlEnv
+
+#: Width of the tactician observation without the trend input.
+NO_TREND_DIM = 28
+
+
+@dataclass(kw_only=True)
+class LeagueOpponentActionCfg(OpponentTacticsActionCfg):
+    """`checkpoint`: the roster's walking policies (comma-separated, each once);
+    `entries`: (walking-policy index, tactician path or "") per wrestler."""
+
+    entries: list = field(default_factory=list)
+    names: list = field(default_factory=list)
+    #: Whether any wrestler in the roster reads a memory (its 7th field 1).
+    memory: bool = False
+    #: Per entry, the claws' lean for a claw wrestler (the roster's waza field: 1, 1:x,
+    #: 2 for 0), or None for one without claws (10/14 night: the league can field the
+    #: claw wrestlers -- 鋏ノ富士, 正面山, ... -- and the learner meets them).
+    leans: list = field(default_factory=list)
+    #: The entity a walker in the roster walks at: the robot, for the west side;
+    #: the opponent, for a league on the east side too (`use_league`, the gyoji's
+    #: training, where neither wrestler learns).
+    target: str = "robot"
+
+    def build(self, env: "ManagerBasedRlEnv") -> "LeagueOpponentAction":
+        return LeagueOpponentAction(self, env)
+
+
+class LeagueOpponentAction(TacticsAction):
+    cfg: LeagueOpponentActionCfg
+
+    def __init__(self, cfg: LeagueOpponentActionCfg, env: "ManagerBasedRlEnv"):
+        self._entries = list(cfg.entries)
+        tac_paths = sorted({t for _, t in self._entries if t})
+        self._tacticians = [FrozenActor(Path(p), str(env.device)) for p in tac_paths]
+        wide = [t for t in self._tacticians if t.obs_dim > CLAW_TREND_DIM]
+        if wide and not cfg.memory:
+            raise ValueError("a tactician in the league reads a memory: mark it in the roster's 7th field")
+        self._tac_index = {p: i for i, p in enumerate(tac_paths)}
+        n = env.num_envs
+        self._entry = torch.zeros(n, dtype=torch.long, device=env.device)
+        self._tac = torch.full((n,), -1, dtype=torch.long, device=env.device)
+        leans = list(cfg.leans) or [None] * len(self._entries)
+        self._claws = any(x is not None for x in leans)
+        #: 13 outputs when the roster has claw wrestlers: theirs; the others' last 7 are 0.
+        self._dim = ACTION_DIM + (7 if self._claws else 0)
+        self._entry_lean = torch.tensor([x if x is not None else 0.0 for x in leans], device=env.device)
+        self._entry_claws = torch.tensor([x is not None for x in leans], device=env.device)
+        super().__init__(cfg, env)
+        self._raw = torch.zeros(self.num_envs, self._dim, device=self.device)
+        self._tac_obs = None
+        #: Bouts so far against each roster entry (for logs).
+        self.drawn = torch.zeros(len(self._entries), dtype=torch.long, device=self.device)
+
+    @property
+    def action_dim(self) -> int:
+        return 0 if getattr(self, "_hidden", False) else self._action_dim
+
+    def _draw(self, env_ids: torch.Tensor) -> None:
+        super()._draw(env_ids)
+        if not getattr(self, "_entries", None):
+            return
+        e = torch.randint(len(self._entries), (len(env_ids),), device=self.device)
+        self._entry[env_ids] = e
+        walker = torch.tensor([w for w, _ in self._entries], device=self.device)
+        tac = torch.tensor([self._tac_index[t] if t else -1 for _, t in self._entries],
+                           device=self.device)
+        self._which[env_ids] = walker[e]
+        self._tac[env_ids] = tac[e]
+        if hasattr(self, "drawn"):
+            self.drawn += torch.bincount(e, minlength=len(self._entries))
+
+    def _tactician_obs(self) -> torch.Tensor:
+        if self._tac_obs is None:
+            from mjlab.managers.observation_manager import ObservationManager
+
+            self._tac_obs = ObservationManager({"tactician": self.cfg.tactician_group}, self._env)
+        return self._tac_obs.compute_group("tactician", update_history=True)
+
+    def process_actions(self, actions: torch.Tensor) -> None:
+        del actions
+        env = self._env
+        state = bout(env)
+        state.update()
+        # 1. Tacticians: each on its own envs.
+        raw = torch.zeros(self.num_envs, self._dim, device=self.device)
+        if self._tacticians:
+            obs = self._tactician_obs()
+            for k, tac in enumerate(self._tacticians):
+                mask = self._tac == k
+                if bool(mask.any()):
+                    raw[mask, :tac.act_dim] = tac(_inputs_for(tac.obs_dim, obs)[mask])
+        self._raw = raw
+        self._choice = raw.clamp(-1.0, 1.0)
+        if self._claws:
+            # The claw wrestlers' seven claw outputs, with their own lean; the others'
+            # claws idle (0, no lean).
+            from .waza import SIDES, waza
+
+            w = waza(env)
+            if w is not None:
+                has = self._entry_claws[self._entry]
+                side = SIDES.index(self.cfg.entity_name)
+                w.lean_env[side] = torch.where(has, self._entry_lean[self._entry], torch.zeros_like(self._entry_lean[self._entry]))
+                w.command(side, torch.where(has[:, None], self._choice[:, ACTION_DIM:], torch.zeros_like(self._choice[:, ACTION_DIM:])))
+        # 2. Commands: a tactician's mapped choice, or a walker's walk at the robot.
+        tac_twist, tac_posture = TacticsAction.commands(self)
+        walk = approach_command(self._entity, env.scene[self.cfg.target], self._speed)
+        neutral = torch.tensor([0.0, 0.0, 0.0, self.cfg.neutral_height], device=self.device)
+        crouch = neutral + torch.tensor(SHIKIRI_POSTURE, device=self.device)
+        walk_twist = shikiri_or(walk, state.started, hold_mark(env, self.cfg.entity_name))
+        walk_posture = shikiri_or(neutral.expand(self.num_envs, 4), state.started, crouch)
+        is_tac = (self._tac >= 0)[:, None]
+        env.command_manager.get_term(self.cfg.twist_name).set(torch.where(is_tac, tac_twist, walk_twist))
+        env.command_manager.get_term(self.cfg.posture_name).set(
+            torch.where(is_tac, tac_posture, walk_posture))
+        # 3. Walking policies: each env its own entry's.
+        JointPositionAction.process_actions(self, self._act(self._observe()))
+        self._overlay_arms()
+
+    def reset(self, env_ids: torch.Tensor | slice | None = None) -> None:
+        super().reset(env_ids)
+        ids = slice(None) if env_ids is None else env_ids
+        self._raw[ids] = 0.0
+        if self._tac_obs is not None:
+            self._tac_obs.reset(env_ids)
+
+
+#: The tactician observation with the trend and the claws (60): own motion 6, opponent 8,
+#: ring 6, bout 2, actions 13, trend 3, claws 22. A tactician without claws reads the
+#: first 22, the first 6 of the actions, and (trained with it) the trend. A league with
+#: a memory wrestler appends the memory (96) after these 60.
+CLAW_TREND_DIM = 60
+_NO_CLAW_TREND = list(range(28)) + [35, 36, 37]
+
+
+def _inputs_for(width: int, obs: torch.Tensor) -> torch.Tensor:
+    """The columns of the league's tactician observation a tactician of `width`
+    inputs was trained on."""
+    if width == obs.shape[-1]:
+        return obs
+    if obs.shape[-1] > CLAW_TREND_DIM and width == CLAW_TREND_DIM:
+        return obs[:, :CLAW_TREND_DIM]
+    if obs.shape[-1] >= CLAW_TREND_DIM and width == 31:
+        return obs[:, _NO_CLAW_TREND]
+    return obs[:, :NO_TREND_DIM]
+
+
+def _lean(field: str):
+    """The roster's waza field: '' / '0' no claws (None), '1' lean 1, '2' lean 0, '1:x'."""
+    field = (field or "").strip()
+    if field in ("", "0"):
+        return None
+    if field == "2":
+        return 0.0
+    if ":" in field:
+        return float(field.split(":", 1)[1])
+    return 1.0
+
+
+def _native(path: str) -> str:
+    """A Git Bash path (/c/Users/...) as Windows Python opens it; others unchanged."""
+    import os
+    import re
+
+    m = re.match(r"^/([a-zA-Z])/(.*)$", path)
+    return f"{m.group(1).upper()}:/{m.group(2)}" if (m and os.name == "nt") else path
+
+
+def use_league_opponent(cfg, radius: float, roster: str) -> None:
+    """Swap the opponent's action for a roster drawn every bout (module docstring)."""
+    use_league(cfg, radius, roster, OPPONENT)
+
+
+def use_league(cfg, radius: float, roster: str, side: str, speed_range=None) -> None:
+    """A roster drawn every bout for `side` ("opponent", or "robot" when no one on
+    the east side learns): the side's action term, named after it, is replaced.
+    For the robot the term is new (the learner's `joint_pos` is the caller's to
+    remove), and its walking policies get the robot's own posture observation."""
+    from ..opponent import opponent_observation_group
+
+    official = str(Path(__file__).resolve().parents[2] / "posture/out/example/model_74800.pt")
+    lines = [l.strip() for l in Path(roster).read_text(encoding="utf-8").splitlines()
+             if l.strip() and not l.strip().startswith("#")]
+    walkers: list[str] = []
+    entries, names, leans = [], [], []
+    memory = False
+    for line in lines:
+        name, kind, ckpt, walking, _trend, waza_field, mem = (line.split("|") + [""] * 7)[:7]
+        leans.append(_lean(waza_field) if kind == "tactician" else None)
+        if kind == "tactician" and mem.strip() == "1":
+            if leans[-1] is None:
+                raise ValueError(f"{name}: a memory wrestler in the league must be a claw wrestler")
+            memory = True
+        ckpt, walking = _native(ckpt), _native(walking) if walking else walking
+        walk = ckpt if kind == "walker" else (walking or official)
+        if walk not in walkers:
+            walkers.append(walk)
+        entries.append((walkers.index(walk), ckpt if kind == "tactician" else ""))
+        names.append(name)
+    base = cfg.actions[OPPONENT]
+    kwargs = {f.name: getattr(base, f.name) for f in dataclasses.fields(OpponentPolicyActionCfg)
+              if f.init}
+    kwargs["checkpoint"] = ",".join(walkers)
+    other = "robot" if side == OPPONENT else OPPONENT
+    if side != OPPONENT:
+        kwargs.update(entity_name=side, twist_name="twist", posture_name="posture",
+                      observation_group=opponent_observation_group(
+                          cfg.observations["actor"], entity=side, twist="twist",
+                          posture="posture", action=side))
+    if speed_range is not None:
+        kwargs["approach_speed_range"] = speed_range
+    cfg.actions[side] = LeagueOpponentActionCfg(
+        **kwargs, tactician="",
+        tactician_group=tactician_group(radius, me=side, other=other, trend=True,
+                                        claws=any(x is not None for x in leans), memory=memory),
+        entries=entries, names=names, leans=leans, target=other, memory=memory)
